# 邮箱(M2)。密码只放在部署机的 .env 里,永远不进仓库。
MAILBOX=sales@example.com
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=sales@example.com
IMAP_PASSWORD=
# 收件与已发送文件夹名。已发送留空则不收;常见名:Sent / "Sent Items" / "已发送"
IMAP_INBOX=INBOX
IMAP_SENT=
# 每隔多少秒收一次
POLL_SECONDS=60
# 公网 OA 门户部署设为 1；仅信任 Caddy 经 OA 会话校验后写入的 X-OA-User。
REQUIRE_OA_AUTH=0
# 可选的多邮箱权限。Owner 按顺序看到这些邮箱；其他登录用户只匹配自己的邮箱地址。
# MAILBOX_OWNER_EMAIL=larry@example.com
# MAILBOX_OWNER_ACCESS=sales@example.com,larry@example.com
# 每个邮箱独立开功能；未列出的邮箱沿用 TASKS。
# MAILBOX_TASKS=sales@example.com=read|leads,larry@example.com=read
# 共享 Sales 收件箱只用于持续收信；SMTP 与开发信发送仍使用上面的主邮箱。
# SHARED_MAILBOX=sales@example.com
# SHARED_IMAP_USER=sales@example.com
# SHARED_IMAP_PASSWORD=
# SHARED_IMAP_INBOX=INBOX
# SHARED_IMAP_SENT=
DB_PATH=data/mail2leads.sqlite3
# 前端构建产物;serve 时托管
WEB_DIST=web/dist
# 监听端口;第二个邮箱的实例换一个
PORT=8900
# 默认只监听本机；经 Tailscale Serve 或反向代理公开。容器部署设为 0.0.0.0。
LISTEN_HOST=127.0.0.1
# 这个邮箱开哪些任务:read 读数(必开)、leads 提线索建议、draft 起草回信。个人邮箱通常只写 read
TASKS=read,leads,draft

# ── 发信(M5)。不填就沿用 IMAP 的账号密码,主机名把 imap. 换成 smtp.;465 走 SMTP_SSL,其余端口 STARTTLS ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# 发件人显示名;发件地址就是 MAILBOX
SENDER_NAME=

# ── 模型(M3)。默认走 Spark 的 LiteLLM 网关;沿用机器上已有的两个变量,不另起一套 ──
LLM_BACKEND=local
DGX_GATEWAY_URL=https://your-gateway.example:4000
DGX_API_KEY=
# 网关路由名(不是 ollama tag):fast 批量摘要 / brain 27B 正式输出。选哪个由评测集裁决
LOCAL_MODEL=fast
LOCAL_TIMEOUT=180
# 走 Claude 时:LLM_BACKEND=claude,并装 uv sync --extra claude
# ANTHROPIC_API_KEY=
# MODEL=claude-opus-5

# ── 下游(M8)。机器只能读 /v1,写线索的接口只认人 ──
# 名字:令牌,逗号分隔;令牌至少 16 字符(openssl rand -hex 32)。名字进日志,令牌永不进日志
API_TOKENS=
# 线索一变就 POST 到这里(HMAC-SHA256 签名,失败按退避重试,永不丢);配了 URL 就必须配 SECRET
WEBHOOK_URL=
WEBHOOK_SECRET=

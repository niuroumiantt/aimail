# 邮箱(M2)。密码只放在部署机的 .env 里,永远不进仓库。
MAILBOX=sales@example.com
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=sales@example.com
IMAP_PASSWORD=
# 收件与已发送文件夹名。已发送留空则不收;常见名:Sent / "Sent Items" / "已发送"
IMAP_INBOX=INBOX
IMAP_SENT=
# 每隔多少秒收一次
POLL_SECONDS=60
DB_PATH=data/mail2leads.sqlite3
# 前端构建产物;serve 时托管
WEB_DIST=web/dist

# ── 发信(M5)。不填就沿用 IMAP 的账号密码,主机名把 imap. 换成 smtp.;465 走 SMTP_SSL,其余端口 STARTTLS ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# 发件人显示名;发件地址就是 MAILBOX
SENDER_NAME=

# ── 模型(M3)。默认走 Spark 的 LiteLLM 网关;沿用机器上已有的两个变量,不另起一套 ──
LLM_BACKEND=local
DGX_GATEWAY_URL=https://your-gateway.example:4000
DGX_API_KEY=
# 网关路由名(不是 ollama tag):fast 批量摘要 / brain 27B 正式输出。选哪个由评测集裁决
LOCAL_MODEL=fast
LOCAL_TIMEOUT=180
# 走 Claude 时:LLM_BACKEND=claude,并装 uv sync --extra claude
# ANTHROPIC_API_KEY=
# MODEL=claude-opus-5
